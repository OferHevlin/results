import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats
import string

raw_df = pd.read_excel("micro CT results.xlsx")

row_names_all = {
    0: 'Vox',
    1: 'Vair', 
    2: 'Vcells', 
    3: 'Vtotal', 
    4: 'Vair_Vcells',
    5: 'Sox',
    6: 'Sair', 
    7: 'Scells', 
    8: 'Sair_Scells', 
    10: 'Thicknessavg'
}

ylabels_map_all = {
    0: '$V_{\mathrm{ox}}$ ($\mu\mathrm{m}^3$)',
    1: '$V_{\mathrm{air}}$ ($\mu\mathrm{m}^3$)',
    2: '$V_{\mathrm{cells}}$ ($\mu\mathrm{m}^3$)',
    3: '$V_{\mathrm{total}}$ ($\mu\mathrm{m}^3$)',
    4: '$V_{\mathrm{air}}$ / $V_{\mathrm{cells}}$ (%)',
    5: '$S_{\mathrm{ox}}$ ($\mu\mathrm{m}^2$)',
    6: '$S_{\mathrm{air}}$ ($\mu\mathrm{m}^2$)',
    7: '$S_{\mathrm{cells}}$ ($\mu\mathrm{m}^2$)',
    8: '$S_{\mathrm{air}}$ / $S_{\mathrm{cells}}$ (%)',
    10: 'Leaf thickness ($\mu$m)'
}

cols_A = ['A1', 'A2', 'A3']
cols_D = ['D1', 'D2', 'D3']

records_all = []
for col in cols_A:
    d = {'Plant': col, 'RoomName': '34/28°C'}
    for idx, var in row_names_all.items():
        d[var] = raw_df.loc[idx, col]
    records_all.append(d)

for col in cols_D:
    d = {'Plant': col, 'RoomName': '16/10°C'}
    for idx, var in row_names_all.items():
        d[var] = raw_df.loc[idx, col]
    records_all.append(d)

df_all = pd.DataFrame(records_all)
room_order = ["16/10°C", "34/28°C"]
colors = ["#89AFFF", "#FF9D66"]
df_all['RoomName'] = pd.Categorical(df_all['RoomName'], categories=room_order, ordered=True)

# Calculate p-values
p_values = {}
for idx, var in row_names_all.items():
    if var in ['Vox', 'Sox']:
        sub_df = df_all[df_all['Plant'] != 'D1']
    else:
        sub_df = df_all
    g1 = sub_df[sub_df['RoomName'] == '16/10°C'][var].dropna()
    g2 = sub_df[sub_df['RoomName'] == '34/28°C'][var].dropna()
    t_stat, p_val = stats.ttest_ind(g1, g2)
    p_values[var] = p_val

plt.rcdefaults()
sns.set_theme(style="white")

# 5 rows x 2 columns layout
fig, axes = plt.subplots(5, 2, figsize=(18, 30))
axes = axes.flatten()

alphabet = list(string.ascii_lowercase)

for i, (idx, var) in enumerate(row_names_all.items()):
    ax = axes[i]
    panel_lbl = f"({alphabet[i]})"
    
    if var in ['Vox', 'Sox']:
        curr_data = df_all[df_all['Plant'] != 'D1'].dropna(subset=[var, 'RoomName']).copy()
    else:
        curr_data = df_all.dropna(subset=[var, 'RoomName']).copy()
        
    p_val = p_values[var]
    if p_val < 0.001:
        p_text = "$p < 0.001$"
    else:
        p_text = f"$p = {p_val:.3f}$"
        
    ax.set_facecolor('white')
    
    # Boxplot
    sns.boxplot(data=curr_data, x='RoomName', y=var, order=room_order, palette=colors,
                width=0.4, showfliers=False, whis=[0, 100], linewidth=2.0, ax=ax,
                boxprops=dict(edgecolor='black'), medianprops=dict(color='black', linewidth=3.5))
    
    # Stripplot
    sns.stripplot(data=curr_data, x='RoomName', y=var, order=room_order, 
                  color='black', alpha=0.4, jitter=True, size=10, ax=ax)
    
    # Gridlines
    ax.grid(True, which='major', axis='both', color='#E0E0E0', linestyle='-', linewidth=1.0)
    ax.set_axisbelow(True)
    
    # Spines
    for spine in ax.spines.values():
        spine.set_color('#CCCCCC')
        spine.set_linewidth(1.2)
        
    # Fonts
    ax.set_ylabel(ylabels_map_all[idx], fontsize=25, fontweight='bold', color='black')
    ax.set_xlabel('Growth temperature', fontsize=24, fontweight='bold', color='black')
    ax.tick_params(axis='both', labelsize=21, labelcolor='black', colors='#555555', width=1.5, length=6)
    
    # Scientific offset text size
    ax.yaxis.get_offset_text().set_fontsize(19)
    
    # Range
    vals = curr_data[var]
    ymin, ymax = (vals.min() * 0.6 if vals.min() > 0 else 0), vals.max() * 1.25
    if var in ['Vair_Vcells', 'Sair_Scells']:
        ymin = 0
    ax.set_ylim(ymin, ymax)
            
    # p-value Annotation in top right corner
    ax.text(0.95, 0.94, p_text, transform=ax.transAxes,
            fontsize=22, fontweight='bold', color='black', ha='right', va='top',
            bbox=dict(facecolor='white', alpha=0.9, edgecolor='none', boxstyle='round,pad=0.25'))
            
    # Panel Label in top left corner
    ax.text(0.04, 0.94, panel_lbl, transform=ax.transAxes, 
            fontsize=28, fontweight='bold', va='top', ha='left',
            bbox=dict(facecolor='white', alpha=0.9, edgecolor='none', boxstyle='round,pad=0.25'))

plt.tight_layout()
plt.savefig('micro_ct_all_10_pvalues_only.png', dpi=300, bbox_inches='tight')
plt.savefig('micro_ct_all_10_pvalues_only.pdf', bbox_inches='tight')
plt.close()

print("Plot successfully created without Tukey letters and with prominent p-values!")
