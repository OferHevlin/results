import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import io
from scipy import stats

data = """Plant,stroma,cytosol,cell wall,chloroplast,plasma,air spaces
A2,25.23258,2.424643,65.24824,2.776191,2.776191,1.542158
A2,23.13867,1.646286,66.79725,3.27327,3.27327,1.871246
A3,22.27385,2.203905,66.50593,3.274983,3.274983,2.466351
A3,19.25504,3.226857,70.24815,2.83112,2.83112,1.607705
A4,25.23507,1.74181,65.15464,3.24916,3.24916,1.370158
A4,18.96707,2.371247,71.58762,3.116206,3.116206,0.841653
D2,18.08757,5.101751,70.85388,2.448977,2.448977,1.058847
D2,19.05714,2.739305,71.24043,2.839781,2.839781,1.283561
D3,22.59303,2.890246,65.58781,3.312391,3.312391,2.304133
D3,25.11422,2.77826,64.94634,3.019583,3.019583,1.122015
D4,19.37766,2.290479,71.22578,2.727245,2.727245,1.651597
D4,24.10498,3.390617,64.21859,3.107631,3.107631,2.07055
"""

df = pd.read_csv(io.StringIO(data))

# Standardize column names
rename_dict = {}
if 'cytosol' in df.columns:
    rename_dict['cytosol'] = 'cytoplasm'
for col in df.columns:
    col_str = str(col).lower()
    if 'chloroplas' in col_str or 'envelope' in col_str or 'chloroplast' in col_str:
        rename_dict[col] = 'envelope'

df_clean = df.rename(columns=rename_dict).copy()

components = [
    'stroma',
    'cytoplasm',
    'envelope',
    'plasma',
    'cell wall',
    'air spaces',
]
comp_labels_clean = [
    'Stroma',
    'Cytosol',
    'Chloroplast\nEnvelope',
    'Plasma\nMembrane',
    'Cell Wall',
    'Air Spaces',
]

# Biological replicates: plant means
plant_means = df_clean.groupby(['Plant'])[components].mean()
plant_means['Treatment'] = [
    'A' if str(p).startswith('A') else 'D' for p in plant_means.index
]

treatment_means = plant_means.groupby('Treatment')[components].mean()
treatment_sem = plant_means.groupby('Treatment')[components].sem()

# Calculate independent two-sample t-test for each component
p_values = {}
p_text = {}
for comp in components:
    vals_A = plant_means[plant_means['Treatment'] == 'A'][comp]
    vals_D = plant_means[plant_means['Treatment'] == 'D'][comp]
    t_stat, p_val = stats.ttest_ind(vals_A, vals_D, equal_var=False) # Welch's t-test or student's? Let's check both
    t_stat_eq, p_val_eq = stats.ttest_ind(vals_A, vals_D, equal_var=True)
    p_values[comp] = p_val_eq
    if p_val_eq < 0.001:
        p_text[comp] = f'p < 0.001'
    else:
        p_text[comp] = f'p = {p_val_eq:.3f}'
    print(f"{comp}: t={t_stat_eq:.3f}, p_equal={p_val_eq:.4f}, p_welch={p_val:.4f}")

means_A = treatment_means.loc['A'][components].values
means_D = treatment_means.loc['D'][components].values
sem_A = treatment_sem.loc['A'][components].values
sem_D = treatment_sem.loc['D'][components].values

fig, ax = plt.subplots(figsize=(12, 7), dpi=300)

x = np.arange(len(components))
width = 0.35

color_A = '#2b5c8f'
color_D = '#e66101'

rects1 = ax.bar(
    x - width / 2,
    means_A,
    width,
    yerr=sem_A,
    capsize=5,
    label='A (34/28°C)',
    color=color_A,
    edgecolor='black',
    linewidth=0.7,
    alpha=0.9,
)
rects2 = ax.bar(
    x + width / 2,
    means_D,
    width,
    yerr=sem_D,
    capsize=5,
    label='D (16/10°C)',
    color=color_D,
    edgecolor='black',
    linewidth=0.7,
    alpha=0.9,
)

# Axis titles and labels
ax.set_ylabel('Resistance (%)', fontsize=16, fontweight='bold', labelpad=10)
ax.set_xlabel('Mesophyll Resistance Components', fontsize=16, fontweight='bold', labelpad=12)

ax.set_xticks(x)
ax.set_xticklabels(comp_labels_clean, fontsize=13, fontweight='bold')
ax.set_ylim(0, 95)
ax.tick_params(axis='y', labelsize=13)
ax.grid(axis='y', linestyle='--', alpha=0.4)

# Draw p-value annotations / brackets above each pair of bars
for i, comp in enumerate(components):
    # Top of error bars
    top_A = means_A[i] + sem_A[i]
    top_D = means_D[i] + sem_D[i]
    max_h = max(top_A, top_D)
    
    # Bracket coordinates
    x1, x2 = x[i] - width / 2, x[i] + width / 2
    y_bar = max_h + 3.0
    h_tick = 1.0
    
    # Draw bracket
    ax.plot([x1, x1, x2, x2], [y_bar - h_tick, y_bar, y_bar, y_bar - h_tick], color='black', lw=1.0)
    
    # Draw p-value text
    ax.annotate(
        p_text[comp],
        xy=(x[i], y_bar + 1.0),
        ha='center',
        va='bottom',
        fontsize=10.5,
        fontweight='bold',
        color='black',
    )

# Legend
ax.legend(
    fontsize=12,
    loc='upper right',
    framealpha=0.95
)

plt.tight_layout()
plt.savefig('mesophyll_resistance_pvalues.png', dpi=300, bbox_inches='tight')
plt.savefig('mesophyll_resistance_pvalues.pdf', bbox_inches='tight')
plt.show()
